<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX package manifest for Funkot (desktop full-trust / Tauri).

  Identity values from Partner Center (do not invent replacements):
  - Package/Identity/Name
  - Package/Identity/Publisher
  - Package/Properties/PublisherDisplayName
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="hatsuboshi.jp.Funkotplayer"
    Publisher="CN=FDFC3ACA-C9AA-47DF-9627-BB76E4AE4D64"
    Version="0.4.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Funkot</DisplayName>
    <PublisherDisplayName>hatsuboshi.jp</PublisherDisplayName>
    <Description>Auto-DJ music player for Funkot</Description>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <!--
    Package languages for Partner Center / Microsoft Store. Listed explicitly
    because this tree packs with makeappx from this file (pack-msix.ps1) and
    never runs Visual Studio MakePri. `x-generate` would not expand: UI
    strings live in src/lib/locales/*.ts, not MRT language-qualified resources.
    First entry is the package default language. Keep in sync with LOCALES in
    src/lib/locale.ts (en->en-US, ja->ja-JP, id->id-ID); scripts/check-msix-languages.sh
    enforces that, including against the packed AppxManifest.xml.
  -->
  <Resources>
    <Resource Language="ja-JP" />
    <Resource Language="en-US" />
    <Resource Language="id-ID" />
  </Resources>

  <Dependencies>
    <TargetDeviceFamily
      Name="Windows.Desktop"
      MinVersion="10.0.17763.0"
      MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

  <Applications>
    <!--
      Executable: cargo package name is funkot-player; tauri.conf.json has no
      mainBinaryName, so `tauri build` leaves the cargo binary as funkot-player.exe
      (productName "Funkot" is display / installer branding only).
    -->
    <Application
      Id="Funkot"
      Executable="funkot-player.exe"
      EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Funkot"
        Description="Auto-DJ music player for Funkot"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile
          Square71x71Logo="Assets\Square71x71Logo.png" />
      </uap:VisualElements>
    </Application>
  </Applications>
</Package>
