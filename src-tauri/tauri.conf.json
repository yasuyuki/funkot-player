{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "funkot-player",
  "version": "0.1.0",
  "identifier": "jp.hatsuboshi.funkotplayer",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "funkot-player",
        "width": 420,
        "height": 760
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "android": {
      "minSdkVersion": 26
    }
  }
}
